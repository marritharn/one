</style></head><body><div class="app"><aside class="side" id="side"><div class="logo">NexusShop<small>Fashion & lifestyle</small></div><div class="navtitle">Shop</div><nav class="nav"><a class="active" href="#home">⌂ &nbsp; Overview</a><a href="#products">◈ &nbsp; New arrivals</a><a href="#trending">↗ &nbsp; Trending now</a><a href="#sale">% &nbsp; Sale</a></nav><div class="navtitle">Collections</div><nav class="nav"><a href="#products" onclick="cat('Women')">○ &nbsp; Women</a><a href="#products" onclick="cat('Men')">○ &nbsp; Men</a><a href="#products" onclick="cat('Accessories')">◇ &nbsp; Accessories</a><a href="#products" onclick="cat('Shoes')">⌁ &nbsp; Shoes</a></nav><div class="navtitle">Account</div><nav class="nav"><a href="#" onclick="openD('wish');return false">♡ &nbsp; Wishlist <span id="sw"></span></a><a href="#" onclick="openD('cart');return false">🛍 &nbsp; My bag <span id="sc"></span></a></nav><div class="promo"><p>Editor's pick</p><b>Fresh looks.<br>Better style.</b><p>Discover this season's new fashion edit.</p><button onclick="location.hash='products'">Shop collection</button></div></aside><main class="main" id="home"><header class="top"><button class="mobile" onclick="document.getElementById('side').classList.toggle('open')">☰</button><div class="search"><input id="q" placeholder="Search dresses, sneakers, bags..." oninput="render()"><span>⌕</span></div><div class="actions"><button class="ib" onclick="openD('wish')">♡<span class="count" id="wc">0</span></button><button class="ib" onclick="openD('cart')">🛍<span class="count" id="cc">0</span></button><div class="avatar">NS</div></div></header><section class="hero"><div class="heroText"><div class="eyebrow">Autumn / Winter 2026</div><h1>Wear your<br>own trend.</h1><p>Discover the latest fashion edits, everyday essentials and statement pieces curated for your next look.</p><button class="btn white" onclick="location.hash='products'">Shop new arrivals</button><button class="btn outline" onclick="location.hash='trending'">Explore trends</button></div></section><section class="section" id="trending"><div class="head"><div><h2>Trending now</h2><p>The styles everyone is talking about</p></div></div><div class="trends"><div class="trend"><b>Quiet luxury</b><p>Clean cuts, neutral tones & premium basics.</p></div><div class="trend"><b>Street edit</b><p>Oversized silhouettes with bold sneakers.</p></div><div class="trend"><b>Soft tailoring</b><p>Relaxed blazers, trousers and layered looks.</p></div><div class="trend"><b>Statement bags</b><p>Mini bags and textured accessories.</p></div></div></section><section class="section"><div class="head"><div><h2>Shop by mood</h2><p>Find your next aesthetic</p></div></div><div class="cats"><a class="cat" href="#products" onclick="cat('Women')"><img src="https://images.unsplash.com/photo-1496747611176-843222e1e57c?auto=format&fit=crop&w=600&q=80"><b>Women</b></a><a class="cat" href="#products" onclick="cat('Men')"><img src="https://images.unsplash.com/photo-1617137968427-85924c800a22?auto=format&fit=crop&w=600&q=80"><b>Men</b></a><a class="cat" href="#products" onclick="cat('Shoes')"><img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=600&q=80"><b>Shoes</b></a><a class="cat" href="#products" onclick="cat('Bags')"><img src="https://images.unsplash.com/photo-1584917865442-de89df76afd3?auto=format&fit=crop&w=600&q=80"><b>Bags</b></a><a class="cat" href="#products" onclick="cat('Accessories')"><img src="https://images.unsplash.com/photo-1523170335258-f5ed11844a49?auto=format&fit=crop&w=600&q=80"><b>Accessories</b></a><a class="cat" href="#products" onclick="cat('Beauty')"><img src="https://images.unsplash.com/photo-1596462502278-27bfdc403348?auto=format&fit=crop&w=600&q=80"><b>Beauty</b></a></div></section><section class="section" id="products"><div class="head"><div><h2>New arrivals</h2><p>Fresh drops curated this week</p></div></div><div class="toolbar"><select class="filter" id="cf" onchange="render()"><option>All</option><option>Women</option><option>Men</option><option>Shoes</option><option>Bags</option><option>Accessories</option><option>Beauty</option></select><select class="filter" id="pf" onchange="render()"><option value="0">Any price</option><option value="50">Under ₹50</option><option value="100">Under ₹100</option><option value="200">Under ₹200</option></select><select class="filter" id="sf" onchange="render()"><option value="featured">Featured</option><option value="low">Price low-high</option><option value="high">Price high-low</option><option value="rating">Top rated</option></select><span class="results" id="res"></span></div><div class="grid" id="grid"></div></section><section class="section" id="sale"><div class="head"><div><h2>Fashion editorial</h2><p>Style inspiration for the season</p></div></div><div class="editorial"><div class="ed"><img src="https://images.unsplash.com/photo-1485968579580-b6d095142e6e?auto=format&fit=crop&w=1200&q=85"><div><h3>The new minimal</h3><p>Build a wardrobe around pieces you'll wear again and again.</p></div></div><div class="stack"><div class="ed"><img src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?auto=format&fit=crop&w=800&q=80"><div><h3>Layer up</h3></div></div><div class="ed"><img src="https://images.unsplash.com/photo-1496217590455-aa63a8350eea?auto=format&fit=crop&w=800&q=80"><div><h3>Weekend mood</h3></div></div></div></div></section></main></div><div class="overlay" id="ov" onclick="closeD()"></div><aside class="drawer" id="drawer"><div class="dhead"><h2 id="dt">My bag</h2><button class="close" onclick="closeD()">✕</button></div><div class="tabs"><button id="tc" class="sel" onclick="draw('cart')">Bag</button><button id="tw" onclick="draw('wish')">Wishlist</button></div><div id="db"></div><div id="df"></div></aside><div class="toast" id="toast"></div>
<script>
const P=[['Linen Relaxed Blazer','Women',129,159,4.9,'https://images.unsplash.com/photo-1591369822096-ffd140ec948f?auto=format&fit=crop&w=800&q=80','New'],['Oversized Cotton Shirt','Men',59,79,4.7,'https://images.unsplash.com/photo-1603252110481-7ba873bf42ab?auto=format&fit=crop&w=800&q=80','Bestseller'],['Retro Runner Sneakers','Shoes',89,120,4.8,'https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=800&q=80','Trend'],['Structured Mini Bag','Bags',74,99,4.6,'https://images.unsplash.com/photo-1594223274512-ad4803739b7c?auto=format&fit=crop&w=800&q=80','New'],['Gold Minimal Watch','Accessories',110,145,4.9,'https://images.unsplash.com/photo-1523170335258-f5ed11844a49?auto=format&fit=crop&w=800&q=80','Editor'],['Satin Slip Dress','Women',99,139,4.8,'https://images.unsplash.com/photo-1566174053879-31528523f8ae?auto=format&fit=crop&w=800&q=80','Sale'],['Relaxed Knit Polo','Men',68,90,4.5,'https://images.unsplash.com/photo-1617127365659-c47fa864d8bc?auto=format&fit=crop&w=800&q=80','New'],['Signature Fragrance','Beauty',82,105,4.9,'https://images.unsplash.com/photo-1541643600914-78b084683601?auto=format&fit=crop&w=800&q=80','Bestseller'],['Wide Leg Trousers','Women',79,109,4.7,'https://images.unsplash.com/photo-1506629905607-d9f3b9c0a6b8?auto=format&fit=crop&w=800&q=80','Trend'],['Leather Crossbody','Bags',119,149,4.8,'https://images.unsplash.com/photo-1566150905458-1bf1fc113f0d?auto=format&fit=crop&w=800&q=80','New'],['Chunky Loafers','Shoes',95,125,4.6,'https://images.unsplash.com/photo-1533867617858-e7b97e060509?auto=format&fit=crop&w=800&q=80','Sale'],['Textured Sunglasses','Accessories',45,65,4.5,'https://images.unsplash.com/photo-1511499767150-a48a237f0083?auto=format&fit=crop&w=800&q=80','Hot']];let cart=JSON.parse(localStorage.nxCart||'[]'),wish=JSON.parse(localStorage.nxWish||'[]');const save=()=>{localStorage.nxCart=JSON.stringify(cart);localStorage.nxWish=JSON.stringify(wish);counts()};const counts=()=>{let n=cart.reduce((a,x)=>a+x.q,0);cc.textContent=n;wc.textContent=wish.length;sc.textContent=n||'';sw.textContent=wish.length||''};function cat(x){cf.value=x;setTimeout(render,0)}function render(){let q=document.getElementById('q').value.toLowerCase(),c=cf.value,p=+pf.value,s=sf.value,a=P.map((x,i)=>({...x,i})).filter(x=>(c==='All'||x[1]===c)&&x[0].toLowerCase().includes(q)&&(!p||x[2]<p));if(s==='low')a.sort((x,y)=>x[2]-y[2]);if(s==='high')a.sort((x,y)=>y[2]-x[2]);if(s==='rating')a.sort((x,y)=>y[4]-x[4]);res.textContent=a.length+' products';grid.innerHTML=a.map(x=>`<article class="product"><div class="pic"><img src="${x[5]}" alt="${x[0]}"><span class="badge ${x[6]==='Sale'?'sale':''}">${x[6]}</span><button class="heart ${wish.includes(x.i)?'on':''}" onclick="toggleWish(${x.i})">${wish.includes(x.i)?'♥':'♡'}</button></div><div class="info"><div class="catname">${x[1]}</div><h3>${x[0]}</h3><span class="stars">★★★★★</span> <span class="rating">${x[4]}</span><div class="price">₹${x[2]} <span><small class="old">₹${x[3]}</small><button class="add" onclick="add(${x.i})">+</button></span></div></div></article>`).join('')||'<div class="empty">No styles found.</div>'}function add(i){let x=cart.find(a=>a.i===i);x?x.q++:cart.push({i,q:1});save();toast('Added to your bag')}function toggleWish(i){let n=wish.indexOf(i);n<0?(wish.push(i),toast('Saved to wishlist')):(wish.splice(n,1),toast('Removed from wishlist'));save();render()}function openD(t){ov.classList.add('on');drawer.classList.add('open');draw(t)}function closeD(){ov.classList.remove('on');drawer.classList.remove('open')}function draw(t){tc.classList.toggle('sel',t==='cart');tw.classList.toggle('sel',t==='wish');dt.textContent=t==='cart'?'My bag':'Wishlist';if(t==='cart'){if(!cart.length){db.innerHTML='<div class="empty">Your bag is empty.<br>Add something you love.</div>';df.innerHTML='';return}db.innerHTML=cart.map(x=>{let p=P[x.i];return `<div class="item"><img src="${p[5]}"><div style="flex:1"><h4>${p[0]}</h4><p>₹${p[2]} × ${x.q}</p><button onclick="qty(${x.i},-1)">−</button> ${x.q} <button onclick="qty(${x.i},1)">+</button></div></div>`}).join('');let total=cart.reduce((a,x)=>a+P[x.i][2]*x.q,0);df.innerHTML=`<h3 style="display:flex;justify-content:space-between">Total <span>₹${total}</span></h3><button class="btn" style="width:100%;background:#171717;color:white" onclick="toast('Checkout demo')">Checkout</button>`}else{if(!wish.length){db.innerHTML='<div class="empty">Your wishlist is waiting.</div>';return}db.innerHTML=wish.map(i=>{let p=P[i];return `<div class="item"><img src="${p[5]}"><div style="flex:1"><h4>${p[0]}</h4><p>₹${p[2]}</p><button class="btn" style="padding:7px;background:#171717;color:#fff" onclick="add(${i})">Add to bag</button></div><button onclick="toggleWish(${i})">♥</button></div>`}).join('')}}function qty(i,n){let x=cart.find(a=>a.i===i);x.q+=n;if(x.q<1)cart=cart.filter(a=>a.i!==i);save();draw('cart')}function toast(m){toastEl.textContent=m;toastEl.classList.add('show');clearTimeout(window.tt);window.tt=setTimeout(()=>toastEl.classList.remove('show'),1800)}const toastEl=document.getElementById('toast');counts();render();
</script></body></html>
