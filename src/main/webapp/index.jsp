overflow:hidden;background:linear-gradient(90deg,#111c,#1111),url('https://images.unsplash.com/photo-1483985988355-763728e1935b?auto=format&fit=crop&w=1600&q=85') center/cover;color:#fff}.heroText{padding:60px 50px;max-width:580px}.eyebrow{font-size:10px;letter-spacing:3px;text-transform:uppercase;color:#ddd}.hero h1{font:clamp(44px,6vw,70px)/.98 'Playfair Display';margin:12px 0}.hero p{color:#ddd;max-width:450px}.btn{padding:12px 18px;border-radius:8px;font-weight:bold;font-size:11px}.white{background:#fff;color:#111}.outline{background:transparent;color:white;border:1px solid #aaa;margin-left:7px}.section{margin-top:34px}.head{display:flex;justify-content:space-between;align-items:end;margin-bottom:15px}.head h2{font:28px 'Playfair Display';margin:0}.head p{margin:4px 0 0;color:var(--muted);font-size:11px}.cats{display:grid;grid-template-columns:repeat(6,1fr);gap:11px}.cat{height:115px;border-radius:12px;overflow:hidden;position:relative}.cat img{width:100%;height:100%;object-fit:cover;filter:brightness(.65);transition:.3s}.cat:hover img{transform:scale(1.06)}.cat b{position:absolute;left:13px;bottom:12px;color:#fff;font:18px 'Playfair Display'}.trends{display:grid;grid-template-columns:repeat(4,1fr);gap:11px}.trend{background:#fff;border:1px solid var(--line);border-radius:11px;padding:16px}.trend b{font:18px 'Playfair Display'}.trend p{font-size:11px;color:#777;margin:5px 0 0}.toolbar{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px}.filter{height:38px;border:1px solid var(--line);background:#fff;border-radius:8px;padding:0 11px;font-size:11px}.results{margin-left:auto;color:#777;font-size:11px;align-self:center}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}.product{background:#fff;border:1px solid var(--line);border-radius:12px;overflow:hidden;transition:.2s}.product:hover{transform:translateY(-3px);box-shadow:0 12px 30px #0000000d}.pic{height:290px;position:relative;overflow:hidden}.pic img{width:100%;height:100%;object-fit:cover;transition:.3s}.product:hover .pic img{transform:scale(1.04)}.badge{position:absolute;left:10px;top:10px;background:white;border-radius:5px;padding:5px 7px;font-size:8px;font-weight:bold;text-transform:uppercase}.sale{background:var(--sale);color:#fff}.heart{position:absolute;right:10px;top:10px;width:33px;height:33px;border-radius:50%;background:#fff}.heart.on{color:#b34b35}.info{padding:12px}.catname{font-size:9px;color:#999;text-transform:uppercase;letter-spacing:1px}.info h3{font:17px 'Playfair Display';margin:4px 0}.stars{font-size:10px}.rating{font-size:10px;color:#888}.price{display:flex;justify-content:space-between;align-items:center;margin-top:10px;font-weight:bold}.old{color:#aaa;text-decoration:line-through;font-size:10px;font-weight:normal}.add{background:#171717;color:#fff;width:35px;height:35px;border-radius:8px;font-size:18px}.editorial{display:grid;grid-template-columns:1.3fr .7fr;gap:13px}.ed{height:300px;border-radius:13px;overflow:hidden;position:relative;color:white}.ed img{width:100%;height:100%;object-fit:cover;filter:brightness(.65)}.ed div{position:absolute;left:23px;bottom:20px}.ed h3{font:30px 'Playfair Display';margin:0}.stack{display:grid;grid-template-rows:1fr 1fr;gap:13px}.stack .ed{height:auto}.drawer{position:fixed;right:0;top:0;bottom:0;width:380px;max-width:92%;background:#fff;z-index:50;padding:24px;transform:translateX(100%);transition:.3s;box-shadow:-15px 0 40px #0002;overflow:auto}.drawer.open{transform:none}.overlay{display:none;position:fixed;inset:0;background:#0005;z-index:40}.overlay.on{display:block}.dhead{display:flex;justify-content:space-between}.dhead h2{font:26px 'Playfair Display'}.close{width:34px;height:34px;border-radius:8px}.tabs{border-bottom:1px solid var(--line);padding-bottom:10px}.tabs button{padding:8px 12px;background:none}.tabs .sel{background:#171717;color:#fff;border-radius:7px}.item{display:flex;gap:10px;padding:12px 0;border-bottom:1px solid var(--line)}.item img{width:62px;height:70px;object-fit:cover;border-radius:7px}.item h4{font:14px 'Playfair Display';margin:0}.item p{font-size:11px;color:#777}.empty{text-align:center;color:#888;padding:50px 10px}.toast{position:fixed;right:20px;bottom:20px;background:#171717;color:#fff;padding:12px 17px;border-radius:8px;z-index:100;opacity:0;transform:translateY(20px);transition:.25s}.toast.show{opacity:1;transform:none}.mobile{display:none}
